{
  "name": "@himalayan-estates/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "auth:hash": "tsx scripts/hash-password.ts",
    "test:security": "tsx --test tests/security.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "next": "15.5.29",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "8.5.33"
  }
}
