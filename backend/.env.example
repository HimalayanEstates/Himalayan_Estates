# Neon PostgreSQL
DATABASE_URL="postgresql://user:password@ep-example-pooler.neon.tech/himalayan_estates?sslmode=require&connection_limit=5&connect_timeout=15&pool_timeout=15"
DIRECT_DATABASE_URL="postgresql://user:password@ep-example.neon.tech/himalayan_estates?sslmode=require"

# Legacy server-to-server admin key; browser admin access should use the session routes
ADMIN_API_KEY="replace-with-a-long-local-development-value"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="scrypt.v1.replace-with-output-from-npm-run-auth:hash"
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Cloudinary server configuration
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Browser origin allowed to call the backend
FRONTEND_ORIGIN="http://localhost:3000"

# Enable only behind a proxy that replaces client-supplied IP headers.
TRUST_PROXY_HEADERS="false"
